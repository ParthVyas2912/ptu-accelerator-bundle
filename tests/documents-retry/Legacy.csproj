<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <DefineConstants>LEGACY</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);SKEXP0001;SKEXP0010;SKEXP0011</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" /><Compile Include="KernelRetry.cs" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.15.1" />
  </ItemGroup>
</Project>
